# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=sarai

# LLM API key (used for OpenAI, Anthropic, and TTS via emergentintegrations)
EMERGENT_LLM_KEY=your_api_key_here

# Auth — set a strong random string; sent as X-API-Key header by the frontend
API_KEY=change_me_to_a_strong_random_string

# CORS — the frontend origin allowed to call this API
FRONTEND_URL=http://localhost:3000
